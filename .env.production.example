# 正式環境設定範本。複製成主機上的 .env，再填好標記「必填」的項目。
# 完整步驟見 docs/DEPLOY.md。不要把填好的 .env 提交到 Git。

APP_NAME="BabyGo"
APP_ENV=production
# 由 php artisan key:generate 產生。上線後不要更換，否則登入狀態會全部失效。
APP_KEY=
# 一定要是 false，否則錯誤畫面會洩漏程式碼與設定內容。
APP_DEBUG=false
# 必填：網站的正式網址，要用 https。
APP_URL=https://example.com

APP_LOCALE=zh_TW
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=zh_TW

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DAILY_DAYS=30
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# 預設使用 SQLite，適合單一主機的一家店。資料庫檔案要放在不會被部署覆蓋的位置。
DB_CONNECTION=sqlite
# 必填：絕對路徑。
DB_DATABASE=/var/www/babygo/shared/database.sqlite

# 改用 MySQL／MariaDB 時，換成下面這組設定。
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=babygo
# DB_USERNAME=babygo
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
# Cookie 只走 https。網站還沒掛上 https 前，登入會失敗。
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
QUEUE_CONNECTION=database

# 線上預約靠這裡的鎖防止超收，不可以設成 array。
CACHE_STORE=database

# 目前系統不會寄信，之後做通知時再換成真正的寄信設定。
MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

# 只有第一次建立業主帳號時會用到，建好後請刪除 OWNER_PASSWORD。
OWNER_USERNAME=owner
OWNER_EMAIL=owner@example.com
OWNER_PASSWORD=

# 只有要從舊系統匯入資料時才需要，匯入完可以刪除。
# BIBIDOG_DB_HOST=127.0.0.1
# BIBIDOG_DB_PORT=3306
# BIBIDOG_DB_DATABASE=bibidog
# BIBIDOG_DB_USERNAME=root
# BIBIDOG_DB_PASSWORD=
